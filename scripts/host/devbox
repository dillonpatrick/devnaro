#!/usr/bin/env bash
set -Eeuo pipefail

# ==========================================
# DevBox Host CLI
# ==========================================

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
DEVBOX_DIR="$(cd -- "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devbox"
CONFIG_FILE="$CONFIG_DIR/config"

usage() {
    cat <<'EOF'
DevBox - Docker development environment

Usage:
  devbox [command]

Commands:
  start             Build (if needed) and start DevBox
  stop              Stop the DevBox container without removing resources
  clean             Remove DevBox containers, networks, volumes, and local images
  restart           Recreate DevBox while preserving its home volume
  recreate-all      Rebuild all DevBox resources, including network and home volume
  shell             Enter the running DevBox container (default)
  status            Show container status
  logs              Show container logs
  networks          Show networks connected to DevBox
  doctor            Run health checks
  config            Show machine-specific configuration
  config set workspace PATH  Set workspace directory
  manager status    Show Network Manager process status (or: dm status)
  manager logs      Show Network Manager logs (or: dm logs)
  help              Show this help message

Examples:
  devbox start
  devbox stop
  devbox clean
  devbox status
  devbox
EOF
}

compose() {
    docker compose --project-directory "$DEVBOX_DIR" -f "$DEVBOX_DIR/docker/docker-compose.yml" "$@"
}

require_running() {
    if ! compose ps --status running --services | grep -Fxq devbox; then
        printf 'DevBox is not running. Start it with: devbox start\n' >&2
        exit 1
    fi
}

config_get() {
    local key="$1"
    [[ -f "$CONFIG_FILE" ]] || return 0
    awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$CONFIG_FILE"
}

config_set() {
    local key="$1"
    local value="$2"

    install -d -m 700 "$CONFIG_DIR"
    touch "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    local temp_file
    temp_file="$(mktemp)"
    awk -F= -v key="$key" '$1 != key { print }' "$CONFIG_FILE" > "$temp_file"
    printf '%s=%s\n' "$key" "$value" >> "$temp_file"
    chmod 600 "$temp_file"
    mv "$temp_file" "$CONFIG_FILE"
}

show_config() {
    printf 'DevBox machine configuration\n'
    printf '  Config file: %s\n' "$CONFIG_FILE"

    local workspace_path
    workspace_path="$(config_get workspace_path)"

    if [[ -z "$workspace_path" ]]; then
        workspace_path="$DEVBOX_DIR/../workspace (default)"
    fi

    printf '  Workspace:   %s\n' "$workspace_path"
    printf '  Repository:  %s\n' "$DEVBOX_DIR"
}

command="${1:-shell}"

case "$command" in
    start)
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    stop)
        exec "$DEVBOX_DIR/scripts/host/stop.sh"
        ;;
    clean)
        exec bash "$DEVBOX_DIR/scripts/host/clean.sh"
        ;;
    recreate-all)
        printf 'WARNING: This will remove all DevBox-managed resources, including the devbox_home volume.\n'
        printf 'Your workspace files will be preserved, but files and settings stored in the container home will be lost.\n'
        read -r -p 'Continue? [y/N] ' confirmation

        case "$confirmation" in
            y|Y|yes|YES|Yes)
                ;;
            *)
                printf 'Recreate-all cancelled.\n'
                exit 0
                ;;
        esac

        bash "$DEVBOX_DIR/scripts/host/clean.sh"
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    restart)
        USER_UID="$(id -u)"
        RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
        CODE_BRIDGE_PID="$RUNTIME_DIR/devbox-code-$USER_UID.pid"
        CODE_SOCKET_PATH="$RUNTIME_DIR/devbox-code-$USER_UID.sock"

        if [[ -f "$CODE_BRIDGE_PID" ]]; then
            kill "$(cat "$CODE_BRIDGE_PID")" 2>/dev/null || true
        fi

        rm -f "$CODE_BRIDGE_PID" "$CODE_SOCKET_PATH"
        compose down --remove-orphans
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    shell|enter)
        require_running
        exec docker compose --project-directory "$DEVBOX_DIR" -f "$DEVBOX_DIR/docker/docker-compose.yml" exec devbox zsh
        ;;
    status)
        compose ps devbox
        ;;
    logs)
        compose logs devbox
        ;;
    networks)
        require_running
        exec docker compose --project-directory "$DEVBOX_DIR" -f "$DEVBOX_DIR/docker/docker-compose.yml" exec devbox devbox-manager networks
        ;;
    config)
        case "${2:-show}" in
            show)
                show_config
                ;;
            get)
                case "${3:-}" in
                    workspace) config_get workspace_path ;;
                    *)
                        printf 'Supported key: workspace\n' >&2
                        exit 2
                        ;;
                esac
                ;;
            set)
                case "${3:-}" in
                    workspace)
                        if [[ -z "${4:-}" ]]; then
                            printf 'Usage: devbox config set workspace PATH\n' >&2
                            exit 2
                        fi

                        mkdir -p "$4"
                        workspace_path="$(cd -- "$4" && pwd)"
                        config_set workspace_path "$workspace_path"
                        printf 'Workspace set to: %s\n' "$workspace_path"
                        ;;
                    *)
                        printf 'Supported key: workspace\n' >&2
                        usage >&2
                        exit 2
                        ;;
                esac
                ;;
            *)
                printf 'Usage: devbox config [show|get workspace|set workspace PATH]\n' >&2
                exit 2
                ;;
        esac
        ;;
    doctor)
        require_running
        exec docker compose --project-directory "$DEVBOX_DIR" -f "$DEVBOX_DIR/docker/docker-compose.yml" exec devbox devbox-manager doctor
        ;;
    manager)
        subcommand="${2:-status}"
        require_running

        case "$subcommand" in
            status)
                exec docker compose --project-directory "$DEVBOX_DIR" -f "$DEVBOX_DIR/docker/docker-compose.yml" exec devbox devbox-manager network-manager status
                ;;
            logs)
                exec docker compose --project-directory "$DEVBOX_DIR" -f "$DEVBOX_DIR/docker/docker-compose.yml" exec devbox devbox-manager network-manager logs
                ;;
            *)
                printf 'Unknown manager command: %s\n' "$subcommand" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac