#!/usr/bin/env bash
set -Eeuo pipefail

# ==========================================
# DevBox Host CLI
# ==========================================

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
DEVBOX_DIR="$(cd -- "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devbox"
CONFIG_FILE="$CONFIG_DIR/config"

command="${1:-shell}"

bash "$DEVBOX_DIR/scripts/host/ensure-ports-config.sh"

if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RESET='\033[0m'
    BOLD='\033[1m'
    CYAN='\033[0;96m'
    GREEN='\033[0;32m'
    DIM='\033[2m'
else
    RESET=''
    BOLD=''
    CYAN=''
    GREEN=''
    DIM=''
fi

print_command() {
    printf "  %b%-18s%b %b%s%b\n" "$GREEN" "$1" "$RESET" "$DIM" "$2" "$RESET"
}

usage() {
    printf "\n%bDevBox%b %b- Docker development environment%b\n\n" "$BOLD$CYAN" "$RESET" "$DIM" "$RESET"
    printf "%bUsage:%b\n" "$BOLD$CYAN" "$RESET"
    printf "  %bdevbox%b [command]\n" "$GREEN" "$RESET"
    printf "  %bdevbox%b config [show|get workspace|set workspace PATH]\n" "$GREEN" "$RESET"
    printf "  %bdevbox%b manager [status|logs]\n\n" "$GREEN" "$RESET"
    printf "%bHost commands:%b\n" "$BOLD$CYAN" "$RESET"
    print_command start "Build (if needed) and start DevBox"
    print_command shell "Enter the running DevBox container (default)"
    print_command stop "Stop the container without removing resources"
    print_command clean "Remove DevBox containers, networks, volumes, and local images"
    print_command restart "Restart the existing container"
    print_command recreate "Recreate the container and network, preserving its home volume"
    print_command recreate-all "Rebuild all DevBox resources, including the home volume"
    print_command status "Show container status"
    print_command info "Show DevBox stack, base image, and installed tools"
    print_command logs "Show container logs"
    print_command networks "List networks connected to DevBox"
    print_command doctor "Run health checks inside the container"
    print_command config "Show machine-specific configuration"
    print_command "manager status" "Show Network Manager process status"
    print_command "manager logs" "Show Network Manager logs"
    print_command help "Show this help message"
    printf "\n%bExamples:%b\n" "$BOLD$CYAN" "$RESET"
    printf "  %bdevbox start%b\n" "$GREEN" "$RESET"
    printf "  %bdevbox shell%b\n" "$GREEN" "$RESET"
    printf "  %bdevbox recreate%b\n" "$GREEN" "$RESET"
    printf "  %bdevbox status%b\n" "$GREEN" "$RESET"
    printf "  %bdevbox config set workspace PATH%b\n" "$GREEN" "$RESET"
    printf "  %bdevbox manager logs%b\n\n" "$GREEN" "$RESET"
}

compose() {
    docker compose --project-directory "$DEVBOX_DIR" \
        -f "$DEVBOX_DIR/docker/docker-compose.yml" \
        -f "$DEVBOX_DIR/docker/docker-compose.ports.yml" "$@"
}

require_running() {
    if ! compose ps --status running --services | grep -Fxq devbox; then
        printf 'DevBox is not running. Start it with: devbox start\n' >&2
        exit 1
    fi
}

config_get() {
    local key="$1"
    [[ -f "$CONFIG_FILE" ]] || return 0
    awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$CONFIG_FILE"
}

config_set() {
    local key="$1"
    local value="$2"

    install -d -m 700 "$CONFIG_DIR"
    touch "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    local temp_file
    temp_file="$(mktemp)"
    awk -F= -v key="$key" '$1 != key { print }' "$CONFIG_FILE" > "$temp_file"
    printf '%s=%s\n' "$key" "$value" >> "$temp_file"
    chmod 600 "$temp_file"
    mv "$temp_file" "$CONFIG_FILE"
}

show_config() {
    printf 'DevBox machine configuration\n'
    printf '  Config file: %s\n' "$CONFIG_FILE"

    local workspace_path
    workspace_path="$(config_get workspace_path)"

    if [[ -z "$workspace_path" ]]; then
        workspace_path="$DEVBOX_DIR/../workspace (default)"
    fi

    printf '  Workspace:   %s\n' "$workspace_path"
    printf '  Repository:  %s\n' "$DEVBOX_DIR"
}

case "$command" in
    start)
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    stop)
        exec "$DEVBOX_DIR/scripts/host/stop.sh"
        ;;
    clean)
        exec bash "$DEVBOX_DIR/scripts/host/clean.sh"
        ;;
    recreate-all)
        printf 'WARNING: This will remove all DevBox-managed resources, including the devbox_home volume.\n'
        printf 'Your workspace files will be preserved, but files and settings stored in the container home will be lost.\n'
        read -r -p 'Continue? [y/N] ' confirmation

        case "$confirmation" in
            y|Y|yes|YES|Yes)
                ;;
            *)
                printf 'Recreate-all cancelled.\n'
                exit 0
                ;;
        esac

        bash "$DEVBOX_DIR/scripts/host/clean.sh"
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    restart)
        if ! compose ps --all --services | grep -Fxq devbox; then
            printf 'DevBox container does not exist. Use: devbox start\n' >&2
            exit 1
        fi
        compose restart devbox
        ;;
    recreate)
        USER_UID="$(id -u)"
        RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
        CODE_BRIDGE_PID="$RUNTIME_DIR/devbox-code-$USER_UID.pid"
        CODE_SOCKET_PATH="$RUNTIME_DIR/devbox-code-$USER_UID.sock"

        if [[ -f "$CODE_BRIDGE_PID" ]]; then
            kill "$(cat "$CODE_BRIDGE_PID")" 2>/dev/null || true
        fi

        rm -f "$CODE_BRIDGE_PID" "$CODE_SOCKET_PATH"
        compose down --remove-orphans
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    shell|enter)
        require_running
        exec docker compose --project-directory "$DEVBOX_DIR" \
            -f "$DEVBOX_DIR/docker/docker-compose.yml" \
            -f "$DEVBOX_DIR/docker/docker-compose.ports.yml" exec devbox zsh
        ;;
    status)
        compose ps --format json devbox | python3 "$DEVBOX_DIR/scripts/host/status.py"
        ;;
    info)
        require_running
        exec docker compose --project-directory "$DEVBOX_DIR" \
            -f "$DEVBOX_DIR/docker/docker-compose.yml" \
            -f "$DEVBOX_DIR/docker/docker-compose.ports.yml" exec devbox devbox-manager info
        ;;
    logs)
        compose logs devbox
        ;;
    networks)
        require_running
        exec docker compose --project-directory "$DEVBOX_DIR" \
                    -f "$DEVBOX_DIR/docker/docker-compose.yml" \
                    -f "$DEVBOX_DIR/docker/docker-compose.ports.yml" exec devbox devbox-manager networks
        ;;
    config)
        case "${2:-show}" in
            show)
                show_config
                ;;
            get)
                case "${3:-}" in
                    workspace) config_get workspace_path ;;
                    *)
                        printf 'Supported key: workspace\n' >&2
                        exit 2
                        ;;
                esac
                ;;
            set)
                case "${3:-}" in
                    workspace)
                        if [[ -z "${4:-}" ]]; then
                            printf 'Usage: devbox config set workspace PATH\n' >&2
                            exit 2
                        fi

                        mkdir -p "$4"
                        workspace_path="$(cd -- "$4" && pwd)"
                        config_set workspace_path "$workspace_path"
                        printf 'Workspace set to: %s\n' "$workspace_path"
                        ;;
                    *)
                        printf 'Supported key: workspace\n' >&2
                        usage >&2
                        exit 2
                        ;;
                esac
                ;;
            *)
                printf 'Usage: devbox config [show|get workspace|set workspace PATH]\n' >&2
                exit 2
                ;;
        esac
        ;;
    doctor)
        require_running
        exec docker compose --project-directory "$DEVBOX_DIR" \
                    -f "$DEVBOX_DIR/docker/docker-compose.yml" \
                    -f "$DEVBOX_DIR/docker/docker-compose.ports.yml" exec devbox devbox-manager doctor
        ;;
    manager)
        subcommand="${2:-status}"
        require_running

        case "$subcommand" in
            status)
                exec docker compose --project-directory "$DEVBOX_DIR" \
                    -f "$DEVBOX_DIR/docker/docker-compose.yml" \
                    -f "$DEVBOX_DIR/docker/docker-compose.ports.yml" exec devbox devbox-manager network-manager status
                ;;
            logs)
                exec docker compose --project-directory "$DEVBOX_DIR" \
                    -f "$DEVBOX_DIR/docker/docker-compose.yml" \
                    -f "$DEVBOX_DIR/docker/docker-compose.ports.yml" exec devbox devbox-manager network-manager logs
                ;;
            *)
                printf 'Unknown manager command: %s\n' "$subcommand" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac