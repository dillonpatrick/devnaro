#!/usr/bin/env bash
set -Eeuo pipefail

# ==========================================
# DevBox Host CLI
# ==========================================

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
DEVBOX_DIR="$(cd -- "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devbox"
CONFIG_FILE="$CONFIG_DIR/config"
source "$DEVBOX_DIR/scripts/host/command_registry.sh"

command="${1:-shell}"

if [[ "$command" == "__complete" ]]; then
    shift
    devbox_host_completion "$@"
    exit 0
fi


if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RESET='\033[0m'
    BOLD='\033[1m'
    CYAN='\033[0;96m'
    GREEN='\033[0;32m'
    DIM='\033[2m'
else
    RESET=''
    BOLD=''
    CYAN=''
    GREEN=''
    DIM=''
fi

HELP_WIDTH=86
HELP_BORDER="$(printf '%*s' "$HELP_WIDTH" '')"
HELP_BORDER="${HELP_BORDER// /─}"

print_box_line() {
    local plain="$1"
    local rendered="$2"
    local padding=$((HELP_WIDTH - ${#plain} - 1))
    (( padding < 0 )) && padding=0
    printf "%b│%b %b%*s%b│%b\n" "$CYAN" "$RESET" "$rendered" "$padding" "" "$CYAN" "$RESET"
}

print_command() {
    local command_name="$1"
    local description="$2"
    local command_padding=$((18 - ${#command_name}))
    (( command_padding < 0 )) && command_padding=0
    local plain
    printf -v plain "  %-18s %s" "$command_name" "$description"
    print_box_line "$plain" \
        "  ${GREEN}${command_name}$(printf '%*s' "$command_padding" '')${RESET} ${DIM}${description}${RESET}"
}

usage() {
    printf "\n%b╭%s╮%b\n" "$CYAN" "$HELP_BORDER" "$RESET"
    print_box_line "DevBox - Docker development environment" \
        "${BOLD}${CYAN}DevBox${RESET} ${DIM}- Docker development environment${RESET}"
    printf "%b├%s┤%b\n" "$CYAN" "$HELP_BORDER" "$RESET"
    print_box_line "Usage:" "${BOLD}${CYAN}Usage:${RESET}"
    print_box_line "  devbox [command]" "  ${GREEN}devbox${RESET} [command]"
    print_box_line "  devbox config [show|get workspace|set workspace PATH]" \
        "  ${GREEN}devbox${RESET} config [show|get workspace|set workspace PATH]"
    print_box_line "  devbox manager [status|logs]" \
        "  ${GREEN}devbox${RESET} manager [status|logs]"
    print_box_line "" ""
    print_box_line "Host commands:" "${BOLD}${CYAN}Host commands:${RESET}"
    local command_name
    for command_name in "${DEVBOX_HOST_COMMANDS[@]}"; do
        print_command "$command_name" "${DEVBOX_HOST_COMMAND_DESCRIPTIONS[$command_name]}"
    done
    local subcommand_name subcommand_key
    for subcommand_name in "${DEVBOX_HOST_SUBCOMMANDS_manager[@]}"; do
        subcommand_key="manager $subcommand_name"
        print_command "$subcommand_key" "${DEVBOX_HOST_SUBCOMMAND_DESCRIPTIONS[$subcommand_key]}"
    done
    print_box_line "" ""
    print_box_line "Examples:" "${BOLD}${CYAN}Examples:${RESET}"
    print_box_line "  devbox start" "  ${GREEN}devbox start${RESET}"
    print_box_line "  devbox shell" "  ${GREEN}devbox shell${RESET}"
    print_box_line "  devbox recreate" "  ${GREEN}devbox recreate${RESET}"
    print_box_line "  devbox status" "  ${GREEN}devbox status${RESET}"
    print_box_line "  devbox config set workspace PATH" \
        "  ${GREEN}devbox config set workspace PATH${RESET}"
    print_box_line "  devbox manager logs" "  ${GREEN}devbox manager logs${RESET}"
    print_box_line "  devbox ci" "  ${GREEN}devbox ci${RESET}"
    printf "%b╰%s╯%b\n\n" "$CYAN" "$HELP_BORDER" "$RESET"
}

compose() {
    bash "$DEVBOX_DIR/scripts/host/compose.sh" "$@"
}

require_running() {
    if ! compose ps --status running --services | grep -Fxq devbox; then
        printf 'DevBox is not running. Start it with: devbox start\n' >&2
        exit 1
    fi
}

config_get() {
    local key="$1"
    [[ -f "$CONFIG_FILE" ]] || return 0
    awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$CONFIG_FILE"
}

config_set() {
    local key="$1"
    local value="$2"

    install -d -m 700 "$CONFIG_DIR"
    touch "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    local temp_file
    temp_file="$(mktemp)"
    awk -F= -v key="$key" '$1 != key { print }' "$CONFIG_FILE" > "$temp_file"
    printf '%s=%s\n' "$key" "$value" >> "$temp_file"
    chmod 600 "$temp_file"
    mv "$temp_file" "$CONFIG_FILE"
}

show_config() {
    printf 'DevBox machine configuration\n'
    printf '  Config file: %s\n' "$CONFIG_FILE"

    local workspace_path
    workspace_path="$(config_get workspace_path)"

    if [[ -z "$workspace_path" ]]; then
        workspace_path="$DEVBOX_DIR/../workspace (default)"
    fi

    printf '  Workspace:   %s\n' "$workspace_path"
    printf '  Repository:  %s\n' "$DEVBOX_DIR"
}

case "$command" in
    start)
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    stop)
        exec "$DEVBOX_DIR/scripts/host/stop.sh"
        ;;
    clean)
        exec bash "$DEVBOX_DIR/scripts/host/clean.sh"
        ;;
    recreate-all)
        printf 'WARNING: This will remove all DevBox-managed resources, including the devbox_home volume.\n'
        printf 'Your workspace files will be preserved, but files and settings stored in the container home will be lost.\n'
        read -r -p 'Continue? [y/N] ' confirmation

        case "$confirmation" in
            y|Y|yes|YES|Yes)
                ;;
            *)
                printf 'Recreate-all cancelled.\n'
                exit 0
                ;;
        esac

        bash "$DEVBOX_DIR/scripts/host/clean.sh"
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    restart)
        if ! compose ps --all --services | grep -Fxq devbox; then
            printf 'DevBox container does not exist. Use: devbox start\n' >&2
            exit 1
        fi
        compose restart devbox
        ;;
    recreate)
        USER_UID="$(id -u)"
        RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
        CODE_BRIDGE_PID="$RUNTIME_DIR/devbox-code-$USER_UID.pid"
        CODE_SOCKET_PATH="$RUNTIME_DIR/devbox-code-$USER_UID.sock"

        if [[ -f "$CODE_BRIDGE_PID" ]]; then
            kill "$(cat "$CODE_BRIDGE_PID")" 2>/dev/null || true
        fi

        rm -f "$CODE_BRIDGE_PID" "$CODE_SOCKET_PATH"
        compose down --remove-orphans
        exec "$DEVBOX_DIR/scripts/host/start.sh"
        ;;
    shell|enter)
        require_running
        exec bash "$DEVBOX_DIR/scripts/host/compose.sh" exec devbox zsh
        ;;
    status)
        RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
        STATUS_BINARY="$RUNTIME_DIR/devbox-status-$(id -u)"
        if [[ -x "$STATUS_BINARY" ]]; then
            compose ps --all --format json | "$STATUS_BINARY"
        else
            compose ps --all --format table devbox
        fi
        ;;
    info)
        require_running
        exec bash "$DEVBOX_DIR/scripts/host/compose.sh" exec devbox devbox-manager info
        ;;
    tools)
        printf '%s\n' "The tools command is available only inside the container. Run 'devbox shell', then 'dm tools search QUERY'." >&2
        exit 2
        ;;
    logs)
        compose logs devbox
        ;;
    networks)
        require_running
        exec bash "$DEVBOX_DIR/scripts/host/compose.sh" exec devbox devbox-manager networks
        ;;
    config)
        case "${2:-show}" in
            show)
                show_config
                ;;
            get)
                case "${3:-}" in
                    workspace) config_get workspace_path ;;
                    *)
                        printf 'Supported key: workspace\n' >&2
                        exit 2
                        ;;
                esac
                ;;
            set)
                case "${3:-}" in
                    workspace)
                        if [[ -z "${4:-}" ]]; then
                            printf 'Usage: devbox config set workspace PATH\n' >&2
                            exit 2
                        fi

                        mkdir -p "$4"
                        workspace_path="$(cd -- "$4" && pwd)"
                        config_set workspace_path "$workspace_path"
                        printf 'Workspace set to: %s\n' "$workspace_path"
                        ;;
                    *)
                        printf 'Supported key: workspace\n' >&2
                        usage >&2
                        exit 2
                        ;;
                esac
                ;;
            *)
                printf 'Usage: devbox config [show|get workspace|set workspace PATH]\n' >&2
                exit 2
                ;;
        esac
        ;;
    ci)
        shift
        exec bash "$DEVBOX_DIR/scripts/host/ci.sh" "$@"
        ;;
    doctor)
        require_running
        exec bash "$DEVBOX_DIR/scripts/host/compose.sh" exec devbox devbox-manager doctor
        ;;
    manager)
        subcommand="${2:-status}"
        require_running

        case "$subcommand" in
            status)
                exec bash "$DEVBOX_DIR/scripts/host/compose.sh" exec devbox devbox-manager network-manager status
                ;;
            logs)
                exec bash "$DEVBOX_DIR/scripts/host/compose.sh" exec devbox devbox-manager network-manager logs
                ;;
            *)
                printf 'Unknown manager command: %s\n' "$subcommand" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$command" >&2
        usage >&2
        exit 2
        ;;
esac