
{
  "name": "DevBox Alpine Linux 3.22",
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "devbox",
  "workspaceFolder": "/workspace",

  "shutdownAction": "none",
  "overrideCommand": false,

  "remoteUser": "devuser",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "hashicorp.terraform",
        "eamodio.gitlens",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "files.eol": "\n",
        "editor.formatOnSave": true,
        "python.defaultInterpreterPath": "/opt/devbox-venv/bin/python"
      }
    }
  }
}
